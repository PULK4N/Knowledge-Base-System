{
  "description": "Write authoritative MCP policies into CLAUDE.md and persist useful chat memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*(?:skill_(add|update|delete|reference_(add|update|auto_load_update|delete)|attachment_(add|delete))|feature_(add|remove|status_update|summary_update|skill_(add|remove)|record_(add|update|remove)|review_note_(add|update|remove)|research_discovery_(add|update|remove)|plan_(add|current_update|current_change|remove))|policy_(general_(add|update|remove)|(topic|agent_family)_(create|update|remove|policy_(add|update|remove))|project_(create|update|delete|repository_add|topic_(add|remove)|policy_(add|update|remove))))$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_tool_use.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_tool_use.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*policy_project_(create|repository_add)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
