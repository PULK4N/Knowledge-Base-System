{
  "description": "Load authoritative MCP policies and persist useful chat memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Restoring MCP policies",
            "additionalContextLimit": 25000
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Preparing compacted chat summary",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Loading MCP policies",
            "additionalContextLimit": 25000
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Queuing chat memory"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*skill_(add|update|delete|reference_(add|update|auto_load_update|delete)|attachment_(add|delete))$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Adding session context to skill change"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Queuing tool exchange"
          }
        ]
      },
      {
        "matcher": ".*policy_project_(create|repository_add)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Refreshing MCP policies",
            "additionalContextLimit": 25000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Queuing assistant memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
