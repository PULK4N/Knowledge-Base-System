{
  "description": "Load authoritative MCP policies from trusted Codex repository context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Restoring MCP policies",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Loading MCP policies",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*policy_project_(create|repository_add)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Refreshing MCP policies",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
