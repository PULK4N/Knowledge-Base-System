{
  "description": "Load authoritative MCP policies and persist useful chat memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Restoring MCP policies",
            "additionalContextLimit": 12000
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Preparing compacted chat summary",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Loading MCP policies",
            "additionalContextLimit": 12000
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Queuing chat memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*policy_project_(create|repository_add)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 30,
            "statusMessage": "Refreshing MCP policies",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 5,
            "statusMessage": "Queuing assistant memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/load_policies.py\"",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/write_memory.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
